# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of EXACT allowed browser origins.
# In production this MUST be set (the server refuses to start without it).
# In development, when empty, only localhost on common dev ports is allowed.
CORS_ORIGINS=http://localhost:5173

# ── Reverse Proxy ──────────────────────────────────────────────────────────
# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy.
#
# SECURITY: NEVER set "true" in production. "true" trusts the header from ANY
# client, letting attackers spoof their IP to bypass rate limits.
#
# Correct values (pick ONE):
#   127.0.0.1          — proxy on the same machine (nginx/Caddy on localhost)
#   10.0.0.0/8         — proxy in a private network (AWS/GCP/Docker)
#   (empty)            — no proxy; Fastify connects directly (dev default)
#
# Behind a proxy you MUST set this, or req.ip (and rate-limit keys) will be
# the proxy's IP — collapsing all clients into one rate-limit bucket.
TRUST_PROXY=

# ── Limits ─────────────────────────────────────────────────────────────────
# Global rate limit (requests per minute per IP)
RATE_LIMIT_MAX=300

# Max request body size in bytes (default: 1 MB = 1048576).
# Increase only if you need file uploads through the API.
BODY_LIMIT=1048576

# Request timeout in milliseconds (default: 30s). Protects against slowloris.
REQUEST_TIMEOUT=30000

# Connection timeout in milliseconds (default: 10s).
CONNECTION_TIMEOUT=10000

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/schoolerp

# ── Firebase Admin SDK (server-side admin operations) ──────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Dev scripts (never commit real values — .env is gitignored) ────────────
# scripts/create-dev.ts — password for the seeded dev account
DEV_SEED_PASSWORD=
# scripts/reset-admin-pw.ts — new password (and optionally which account)
RESET_PASSWORD=
RESET_EMAIL=safwancoding1919@gmail.com

# Demo provisioning scripts (required to run createDemoAdminUser / createDemoLibrarianUser)
DEMO_ADMIN_PASSWORD=
DEMO_LIBRARIAN_PASSWORD=

# Local-only fixed email OTP. Ignored when NODE_ENV=production.
EMAIL_OTP_TEST_CODE=
