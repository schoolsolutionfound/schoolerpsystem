# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins (empty = reflect any origin)
CORS_ORIGINS=http://localhost:5173

# Global rate limit (requests per minute per IP)
RATE_LIMIT_MAX=300

# Database Connection (PostgreSQL / Drizzle ORM)
DATABASE_URL=postgres://user:password@localhost:5432/schoolerp

# Firebase Admin SDK Config (Server-side admin operations)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
